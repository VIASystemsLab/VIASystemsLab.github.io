#!/bin/sh
#
# Static checks before a commit is created.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# The checks run against the working tree, not against the staged snapshot.
# For a site with no build step that is the useful behaviour: it catches a
# broken link or a missing asset while you can still see what you were doing.
# If you are committing a subset of your changes on purpose and the hook
# complains about the part you did not stage, use --no-verify knowingly.

set -e

# Refuse a commit that adds a machine-local absolute path: where this clone
# lives, or the committer's home directory. The path exists on one machine
# only, so to everyone else it is a dangling reference, and it publishes the
# account name it contains besides. Only added lines are checked, so a file
# that already carries such a path can still be edited.
root=$(git rev-parse --show-toplevel)

# A home of / (some containers) would match every line, so it is skipped.
home=${HOME:-}
[ "$home" = / ] && home=

found=$(git diff --cached --no-color --no-ext-diff -U0 --diff-filter=ACMR |
    awk -v root="$root" -v home="$home" '
        /^\+\+\+ / { file = substr($0, 7); next }
        /^\+/ {
            line = substr($0, 2)
            if (index(line, root) || (home != "" && index(line, home)))
                printf "  %s: %s\n", file, substr(line, 1, 100)
        }')
if [ -n "$found" ]; then
    echo "pre-commit: staged lines add a machine-local absolute path" >&2
    printf '%s\n' "$found" >&2
    echo "Write it relative to the repository root instead." >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    echo "pre-commit: python3 not found, skipping static checks" >&2
    exit 0
fi

echo "pre-commit: running static checks"
python3 tools/lint.py

# Derived images and icons are generated, never edited by hand. This catches
# the case where the artwork in img/original/ changed but nothing was rebuilt.
if [ -f assets.lock.json ]; then
    python3 tools/build_assets.py --check
fi
