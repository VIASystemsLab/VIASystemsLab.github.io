#!/bin/sh
#
# Enforce the commit message format described in README.md:
#
#     <type>(<scope>): <subject>
#
# type    feat fix docs style refactor perf test build ci chore content
# scope   optional, lowercase, e.g. (nav) (theme) (seo) (assets)
# subject imperative, lowercase first letter, no trailing full stop
#
# The subject line must be 72 characters or fewer. An optional " [BOT]" marks
# a commit written by an agent rather than by hand.

subject=$(head -n 1 "$1")

# Merges, reverts and fixups are generated by git itself; leave them alone.
case "$subject" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if [ ${#subject} -gt 72 ]; then
    echo "commit-msg: subject line is ${#subject} characters, the limit is 72" >&2
    echo "  $subject" >&2
    exit 1
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|content)(\([a-z0-9.-]+\))?: [a-z].*[^.]$'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
    cat >&2 <<MSG
commit-msg: subject line does not match the required format.

  got:      $subject
  expected: <type>(<scope>): <subject>

  type      feat fix docs style refactor perf test build ci chore content
  subject   imperative, lowercase first letter, no trailing full stop

  examples
    fix(nav): keep the current page marked on the projects page
    content(publications): add the EDBT vision paper
    build(assets): regenerate the emblem derivatives
MSG
    exit 1
fi
